# Set default behavior to automatically normalize line endings.
* text=auto

# Force LF for Jupyter notebooks (JSON files)
*.ipynb text eol=lf

# Force LF for Python files
*.py text eol=lf

# Force LF for Markdown files
*.md text eol=lf

# Force LF for YAML files
*.yml text eol=lf
*.yaml text eol=lf

# Force LF for JSON files
*.json text eol=lf

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.pyc binary
*.pdf binary
*.doc binary
*.docx binary
*.ppt binary
*.pptx binary
*.xls binary
*.xlsx binary
*.pth binary
*.onnx binary