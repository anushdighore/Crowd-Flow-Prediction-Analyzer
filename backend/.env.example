# Backend Environment Configuration
# Copy this file to .env and customize for your environment

# ============================================
# Python Configuration
# ============================================
PYTHONPYCACHEPREFIX=target/pycache

# ============================================
# Application Settings
# ============================================
APP_NAME=Crowd Counter API
APP_VERSION=1.0.0
ENV=development
DEBUG=True

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000

# ============================================
# CORS Origins
# ============================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# Paths (relative to backend root)
# ============================================
ML_MODELS_PATH=../ml
CHECKPOINTS_PATH=../ml/checkpoints
CONFIG_DIR=config

# ============================================
# Model Configuration
# ============================================
DEFAULT_MODEL=csrnet
DEVICE=cuda  # or 'cpu' for CPU inference

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO

# ============================================
# Database (if needed in future)
# ============================================
# DATABASE_URL=postgresql://user:password@localhost/crowd_db

# ============================================
# Redis Cache (if needed in future)
# ============================================
# REDIS_URL=redis://localhost:6379/0

# ============================================
# Security (if needed in future)
# ============================================
# SECRET_KEY=your-secret-key-here
# JWT_ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=30
